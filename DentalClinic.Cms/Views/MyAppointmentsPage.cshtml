@using DentalClinic.Cms.Services
@using DentalClinic.Cms.Models
@using DentalClinic.Cms.Controllers
@using Microsoft.AspNetCore.Http
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage

@inject IAppointmentApiClient Appointments
@inject IHttpContextAccessor HttpContextAccessor

@{
    // نستخدم الـ layout العام
    Layout = "master.cshtml";

    // نقرأ الـ JWT من الـ Session
    var token = HttpContextAccessor.HttpContext?.Session.GetString("jwt");

    var appointments = new List<AppointmentResult>();

    if (!string.IsNullOrEmpty(token))
    {
        // نضبط التوكن في الـ HttpClient
        Appointments.SetAuthToken(token);

        // نجيب المواعيد من الـ Gateway (خاصة بالمريض الحالي)
        appointments = await Appointments.GetMyAppointmentsAsync() ?? new List<AppointmentResult>();
    }
}

<h1>My Appointments</h1>

@await Html.PartialAsync("Partials/_FlashMessages")


@* @if (TempData["message"] != null)
{
    <p style="color: green">@TempData["message"]</p>
}
 *@
@if (string.IsNullOrEmpty(token))
{
    <p>You must be logged in to see your appointments.</p>
    <p><a href="/login">Go to login</a></p>
}
else if (appointments == null || !appointments.Any())
{
    <p>You have no appointments.</p>
}
else
{
    <table border="1" cellpadding="5">
        <thead>
            <tr>
                <th>Date</th>
                <th>Time</th>
                <th>Dentist</th>
                <th>Status</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var a in appointments)
        {
            <tr>
                <td>@a.Slot?.Date</td>
                <td>@a.Slot?.Time</td>
                <td>@(string.IsNullOrEmpty(a.DentistName) ? a.DentistId : a.DentistName)</td>
                <td>@a.Status</td>
                <td>
                    @if (a.Status != "Cancelled" && a.Status != "Completed")
                    {
                        @using (Html.BeginUmbracoForm<MyAppointmentsController>("Cancel"))
                        {
                            @Html.Hidden("appointmentId", a.Id)
                            <button type="submit">Cancel</button>
                        }
                    }
                </td>
            </tr>
        }
        </tbody>
    </table>
}
