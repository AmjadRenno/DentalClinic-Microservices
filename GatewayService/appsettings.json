{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "AllowedHosts": "*",

  "AllowedOrigins": [
    "http://localhost:3000",
    "http://localhost:5173",
    "https://localhost:7000"
  ],

  "Jwt": {
    "Key": "CHANGE_ME_IN_PRODUCTION",
    "Issuer": "DentalClinicAuth",
    "Audience": "DentalClinicServices"
  },

  "ReverseProxy": {
    "Routes": {

      "auth-login": {
        "ClusterId": "auth",
        "Match": { "Path": "/auth/login" }
      },

      "auth-register": {
        "ClusterId": "auth",
        "Match": { "Path": "/auth/register" }
      },

      "auth-all": {
        "ClusterId": "auth",
        "Match": { "Path": "/auth/{**remainder}" }
      },

      // Booking Routes

      "booking-mine": {
        "ClusterId": "booking",
        "Match": { "Path": "/api/appointments/mine" },
        "Transforms": [
          { "RequestHeadersCopy": "true" }
        ]
      },

      "booking-cancel": {
        "ClusterId": "booking",
        "Match": { "Path": "/api/appointments/cancel" },
        "Transforms": [
          { "RequestHeadersCopy": "true" }
        ]
      },

      "booking-create": {
        "ClusterId": "booking",
        "Match": { "Path": "/api/appointments" },
        "Transforms": [
          { "RequestHeadersCopy": "true" }
        ]
      },

      "booking-all": {
        "ClusterId": "booking",
        "Match": { "Path": "/api/appointments/{**remainder}" },
        "Transforms": [
          { "RequestHeadersCopy": "true" }
        ]
      },

      // Payment Routes

      "payment": {
        "ClusterId": "payment",
        "Match": { "Path": "/api/payments/{**remainder}" },
        "Transforms": [
          { "RequestHeadersCopy": "true" }
        ]
      },

      // Orchestrator Routes

      "orchestrator": {
        "ClusterId": "orchestrator",
        "Match": { "Path": "/api/workflow/{**remainder}" },
        "Transforms": [
          { "RequestHeadersCopy": "true" }
        ]
      }
    },

    "Clusters": {
      "auth": {
        "Destinations": {
          "d1": { "Address": "https://localhost:7003" }
        }
      },
      "booking": {
        "Destinations": {
          "d1": { "Address": "http://localhost:5175" }
        }
      },
      "payment": {
        "Destinations": {
          "d1": { "Address": "http://localhost:5012" }
        }
      },
      "orchestrator": {
        "Destinations": {
          "d1": { "Address": "http://localhost:5050" }
        }
      }
    }
  }
}
