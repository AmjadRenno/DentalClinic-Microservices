{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "AllowedHosts": "*",

  "Jwt": {
    "Key": "this_is_my_super_secret_key_12345",
    "Issuer": "DentalClinicAuth",
    "Audience": "DentalClinicServices"
  },

  "ReverseProxy": {
    "Routes": {

      "auth-login": {
        "ClusterId": "auth",
        "Match": { "Path": "/auth/login" }
      },

      "auth-register": {
        "ClusterId": "auth",
        "Match": { "Path": "/auth/register" }
      },

      "auth-all": {
        "ClusterId": "auth",
        "Match": { "Path": "/auth/{**remainder}" }
      },

      /* ============================
         🔥 Booking Routes
         ============================ */

      "booking-mine": {
        "ClusterId": "booking",
        "Match": { "Path": "/api/appointments/mine" },
        "Transforms": [
          { "RequestHeadersCopy": "true" }
        ]
      },

      "booking-cancel": {
        "ClusterId": "booking",
        "Match": { "Path": "/api/appointments/cancel" },
        "Transforms": [
          { "RequestHeadersCopy": "true" }
        ]
      },

      "booking-create": {
        "ClusterId": "booking",
        "Match": { "Path": "/api/appointments" },
        "Transforms": [
          { "RequestHeadersCopy": "true" }
        ]
      },

      "booking-all": {
        "ClusterId": "booking",
        "Match": { "Path": "/api/appointments/{**remainder}" },
        "Transforms": [
          { "RequestHeadersCopy": "true" }
        ]
      },

      /* ============================
         Patients + Dentists + Payment
         ============================ */

      "patients": {
        "ClusterId": "patients",
        "Match": { "Path": "/api/patients/{**remainder}" }
      },

      "dentists": {
        "ClusterId": "dentists",
        "Match": { "Path": "/api/dentists/{**remainder}" }
      },

      "payment": {
        "ClusterId": "payment",
        "Match": { "Path": "/api/payments/{**remainder}" }
      }
    },

    "Clusters": {
      "auth": {
        "Destinations": {
          "d1": { "Address": "https://localhost:7003" }
        }
      },
      "booking": {
        "Destinations": {
          "d1": { "Address": "http://localhost:5175" }
        }
      },
      "payment": {
        "Destinations": {
          "d1": { "Address": "http://localhost:5012" }
        }
      },
      "patients": {
        "Destinations": {
          "d1": { "Address": "http://localhost:5272" }
        }
      },
      "dentists": {
        "Destinations": {
          "d1": { "Address": "http://localhost:5004" }
        }
      }
    }
  }
}
